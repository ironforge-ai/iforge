DATABASE_URL=postgresql+asyncpg://clawdi:clawdi_dev@localhost:5433/clawdi

# Clerk Frontend API / JWT issuer URL. The backend fetches signing keys from
# <issuer>/.well-known/jwks.json by default. Use an HTTPS URL; one trailing
# slash is canonicalized away.
CLERK_JWT_ISSUER=
# Optional networkless override. Accepts a verbatim, escaped-newline, or
# base64-encoded PEM public key; when set, no JWKS request is made.
CLERK_PEM_PUBLIC_KEY=
# Server-only Clerk Backend API secret. Needed for user.updated ban authority,
# optional verified-email lookup, and OAuth refresh-grant revocation. Direct
# calls are pinned to Clerk API version 2026-05-12. Never expose it to a client.
CLERK_SECRET_KEY=

# Optional strict audience binding for browser session JWTs. The issuer is
# always checked when CLERK_JWT_ISSUER is configured.
CLERK_JWT_AUDIENCE=

# Dedicated signing secret for this backend's Clerk user.updated + user.deleted
# endpoint. Subscribe only those two events; user.created is intentionally not
# consumed because verified JWTs lazy-create users on their first iforge use.
# Leave blank to keep the endpoint fail-closed (503). Do not reuse the signing
# secret from another Clerk endpoint/bounded context.
CLERK_WEBHOOK_SIGNING_SECRET=
CLERK_WEBHOOK_TOLERANCE_SECONDS=300

# Local-only browser testing bypass. Enables
# `Authorization: Bearer DEV_AUTH_TOKEN` for a synthetic dashboard user when
# ENVIRONMENT=development. Never enable this in deployed environments.
DEV_AUTH_BYPASS=false
DEV_AUTH_TOKEN=dev-bypass
DEV_AUTH_CLERK_ID=dev_browser
DEV_AUTH_EMAIL=dev@iforge.local
DEV_AUTH_NAME="Dev User"

# Generate each with: python3 -c "import os; print(os.urandom(32).hex())"
# The two keys must be DIFFERENT — one encrypts vault data at rest,
# the other signs MCP proxy JWTs.
VAULT_ENCRYPTION_KEY=
ENCRYPTION_KEY=

# The vault keyring (docs/runbooks/vault-key-rotation.md). VAULT_ENCRYPTION_KEY above is
# always version vault.v1. To rotate, add a JSON object of more versions, e.g.
# {"vault.v2": "<64 hex characters>"}, and make one active. Empty means "vault.v1 only".
VAULT_ENCRYPTION_KEYS=
VAULT_ACTIVE_KEY_VERSION=vault.v1

# File store for session archives, skill archives, and uploaded agent avatars.
# Use `local` for development, or `s3` for S3-compatible storage such as R2.
FILE_STORE_TYPE=local
FILE_STORE_LOCAL_PATH=./data/files
FILE_STORE_S3_BUCKET=
FILE_STORE_S3_REGION=auto
FILE_STORE_S3_ENDPOINT_URL=
FILE_STORE_S3_ACCESS_KEY_ID=
FILE_STORE_S3_SECRET_ACCESS_KEY=
FILE_STORE_S3_FORCE_PATH_STYLE=false

DEBUG=true
CORS_ORIGINS=["http://localhost:3000"]

# Admin API key — gates `/api/admin/*` server-to-server endpoints used by
# upstream-SaaS batch tooling (deploy mint, account-deletion revoke, live-sync
# migration of legacy deployments). Default empty = endpoints return 503
# (OSS self-hosters who don't run an upstream SaaS shouldn't expose this
# surface).
#
# When wiring up a SaaS frontend, set this to a strong secret
# (`openssl rand -hex 32`) and configure the matching `IFORGE_CLOUD_ADMIN_API_KEY`
# on the SaaS backend side. Constant-time HMAC comparison.
ADMIN_API_KEY=

# Transitional auth for the six `/v1/platform/*` mutation routes. Disable only
# after every non-v1 cohort uses workload OAuth; this does not affect `/v1/admin/*`.
PLATFORM_LEGACY_ADMIN_AUTH_ENABLED=true
# Independent cloud-api workload authorization-server issuer and exact client
# assertion audience. Leave the endpoint empty to derive it from PUBLIC_API_URL.
PLATFORM_WORKLOAD_ISSUER=clawdi-cloud-platform
PLATFORM_WORKLOAD_TOKEN_ENDPOINT=

# Externally reachable URLs the backend embeds in payloads it hands out.
# PUBLIC_API_URL: this backend's own URL (used for MCP client config etc.).
# WEB_ORIGIN:     the dashboard URL — the CLI device-flow `verification_uri`
#                 is built from this, so the user opens the right host in
#                 their browser. In prod, set to e.g. https://cloud.iforge.dev.
PUBLIC_API_URL=http://localhost:8000
WEB_ORIGIN=http://localhost:3000

# Server-to-server connection to the hosted billing service (`/v2`): the
# billing gate reads subscriptions through it, and the tenant purge tears down
# deployments and cancels subscriptions through it.
# DEPLOY_API_URL: the hosted billing service's base URL.
# DEPLOY_API_KEY: the raw service key, sent as a bearer token; the hosted
#                 service stores only its SHA-256.
# Empty = every `/v2` consumer stays dark, and a tenant purge FAILS rather
# than claim a teardown it never ran, unless TENANT_PURGE_SKIP_HOSTED_TEARDOWN
# is set for a deployment with no hosted service.
DEPLOY_API_URL=
DEPLOY_API_KEY=

# Billing gate. When true, an account without an active or trialing
# subscription (and without a billing exemption) gets 403 `billing_required`
# until it pays. Needs DEPLOY_API_URL/DEPLOY_API_KEY above. Default false, so
# self-hosted deployments are unaffected.
BILLING_GATE_ENABLED=false
# INT-1: how often an unlocked user's subscription is re-read, and how long a
# lapse is tolerated before the user is locked again (defaults: 1 hour, 1 day).
# BILLING_RECHECK_INTERVAL_SECONDS=3600
# BILLING_LAPSE_GRACE_SECONDS=86400

# Dedicated DNS zone for tenant-installed companions (e.g. Postiz). Each
# installation is served at one generated label directly beneath it. Use a
# registrable domain separate from this deployment's own origins so a
# companion's cookies never reach them. Empty = companion installs are
# refused with 503 `companion_edge_zone_unconfigured`.
COMPANION_EDGE_ZONE_NAME=

# Per-installation companion media on Cloudflare R2: one bucket, one bucket-scoped
# token and one `media-<suffix>.<zone>` domain per installation. The API token
# administers R2 buckets, account API tokens and the companion zone's custom
# domains; the admin S3 key pair only empties a bucket at teardown. Empty = the
# install job's media step fails by name before any call.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_API_TOKEN=
CLOUDFLARE_R2_S3_ENDPOINT=
CLOUDFLARE_R2_ADMIN_ACCESS_KEY_ID=
CLOUDFLARE_R2_ADMIN_SECRET_ACCESS_KEY=
COMPANION_EDGE_ZONE_ID=

# Each companion installation's own hostname: one remotely-managed Cloudflare
# Tunnel per installation (account above) and one proxied CNAME in the companion
# zone, published only after the runtime reports the install ready. Scope the
# token to Cloudflare Tunnel edit on the account and DNS edit on the companion
# zone only. Empty = the install job's edge steps fail by name before any call.
CLOUDFLARE_TUNNEL_API_TOKEN=

# Each companion installation's pgBackRest repository: a Backblaze B2 bucket in
# an account SEPARATE from the compute provider and from Cloudflare, created
# with Object Lock and file versioning on. The key below only mints and revokes
# one no-delete key per installation (listFiles, readFiles, writeFiles on
# <tenant>/<installation>/), so it needs writeKeys, listKeys and deleteKeys.
# S3_ENDPOINT is the bucket's host (s3.<region>.backblazeb2.com) and REGION its
# region segment. Empty = the install job's backup step fails by name before
# any call.
COMPANION_BACKUP_B2_KEY_ID=
COMPANION_BACKUP_B2_APPLICATION_KEY=
COMPANION_BACKUP_B2_BUCKET_ID=
COMPANION_BACKUP_B2_BUCKET_NAME=
COMPANION_BACKUP_B2_S3_ENDPOINT=
COMPANION_BACKUP_B2_REGION=

# The shared Temporal frontend for the standard tier: FRONTEND_ADDRESS is the
# host:port tenant VMs dial, HTTP_URL the same frontend's HTTP API as this
# backend reaches it. The RS256 private key's public half must be published in
# the frontend's JWKS under JWT_KEY_ID. Empty = the install job's Temporal step
# fails by name before any call. Retention is 1-90 days.
COMPANION_TEMPORAL_FRONTEND_ADDRESS=
COMPANION_TEMPORAL_HTTP_URL=
COMPANION_TEMPORAL_TLS=true
COMPANION_TEMPORAL_JWT_PRIVATE_KEY=
COMPANION_TEMPORAL_JWT_KEY_ID=
COMPANION_TEMPORAL_NAMESPACE_RETENTION_DAYS=7

# The default monthly companion spend ceiling, in integer micro-dollars
# (1 USD = 1000000), for tenants that have not set their own. A tenant's own
# ceiling always wins. At the ceiling, agent tool calls and new companion
# installs are refused; installed companions keep running. Empty = no default
# (tenants without a ceiling are unbounded). 0 refuses everything for them.
COMPANION_DEFAULT_SPEND_CEILING_USD_MICROS=

# Opt in only for a Cloud control-plane deployment that should mirror the
# public Agent Plugin Store catalog into PostgreSQL. Local and self-hosted
# deployments leave this disabled and make no catalog sync requests to GitHub.
PLUGIN_CATALOG_SYNC_ENABLED=false

# From composio.dev dashboard. Leave blank to disable connectors.
COMPOSIO_API_KEY=

# --- Memory embedder (used by the Builtin memory provider) ---
# local = fastembed ONNX, ~1GB download on first use, no API key. Default.
# local-service = one FastEmbed worker over a host-local Unix socket.
# api   = OpenAI-compatible API. Set MEMORY_EMBEDDING_API_KEY and
#         optionally MEMORY_EMBEDDING_BASE_URL + MEMORY_EMBEDDING_MODEL.
MEMORY_EMBEDDING_MODE=local
MEMORY_EMBEDDING_API_KEY=

# e.g. https://openrouter.ai/api/v1
MEMORY_EMBEDDING_BASE_URL=

MEMORY_EMBEDDING_MODEL=text-embedding-3-small

# Used only by local-service and the dedicated embedding worker.
MEMORY_EMBEDDING_SERVICE_SOCKET_PATH=/run/iforge-embedding/embedding.sock
MEMORY_EMBEDDING_SERVICE_TIMEOUT_SECONDS=30
MEMORY_EMBEDDING_THREADS=0
MEMORY_EMBEDDING_WORKER_MAX_CONCURRENCY=1

# Log API requests at or above this backend processing time, in milliseconds.
# Set to 0 to disable slow-request logs. Responses always include
# X-Process-Time-Ms for direct per-request inspection.
SLOW_REQUEST_LOG_MS=750
