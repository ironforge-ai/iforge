backend/scripts/seed_demo.py
backend/pdm.lock
.kamal/secrets
.kamal/secrets.tmp

# Local UAT stack logs (scripts/uat-stack.sh)
.uat-logs/

# GSD runtime state (dispatch-isolation sentinel). Tool residue, not repository
# content: the residual guard reads untracked files since 03.1-11 (WR-06), so an
# unignored runtime dir would otherwise demand a scope decision it does not merit.
.gsd/

# GSD per-session pid lock. Swept into c127262e by a broad `git add -A .planning`;
# it names a pid and session id, so it is machine-local and must not travel.
# NOTE: .planning/research/.cache/ is deliberately NOT ignored — it was committed
# on purpose by 56364cdc "docs: complete project research" and is a project
# artifact, not a throwaway cache.
.planning/milestone.lock
